# EasyGSTBilling settings. Copy this file to .env and edit it.
# docker compose reads .env automatically (packaging/docker/docker-compose.yml).
# A plain desktop install reads .env from the app folder or the books folder.

# The app's PIN: 6 or 8 digits. It guards phone/tablet pairing and the
# manual "Lock now" button. The app never asks for a PIN at startup.
# If the books already have a different PIN, this one wins on the next start.
EASYGST_PIN=123456

# Legacy name still works:
# FGSB_PIN=123456

# Phone / tablet access port inside the container (default 47443).
# FGSB_PHONE_PORT=47443

# Extra host names / addresses the phone listener answers (comma separated).
# FGSB_PHONE_HOSTS=192.168.1.50
